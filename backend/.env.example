# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres all work)
DATABASE_URL=postgresql://user:password@host:5432/kharcha?sslmode=require

# Any long random string - used to sign JWT tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Port the backend runs on
PORT=4000

# Your deployed/local frontend URL, for CORS
FRONTEND_URL=http://localhost:3000
